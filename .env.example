API_BASE_URL=https://fcapidev.cerity.farm
PROD_API_BASE_URL=https://fcapi.cerity.farm
ADMIN_API_KEY=
INGEST_EMAIL=
INGEST_PASSWORD=
LOCATION_ID=1
DRY_RUN=true
REF_SOURCE=prod
BACKCHECK_PROD=false
# Local LLM (Ollama + Qwen)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=60000

# Push notification targeting (comma-separated emails, or leave empty for audience mode)
NOTIFY_EMAILS=kevin.coelho@gmail.com

# Partner boat IDs
ELDORADO_BOAT_ID=104
ELPATRON_BOAT_ID=
OCEANSIDE_BOAT_ID=

# Reporter user ID (fallback if not resolved from login)
REPORTER_USER_ID=

# Analytics event logging (optional)
# When unset, push-sent analytics POST is skipped (sends still logged to state/notification_send_log.json).
# Set to the backend endpoint path once it exists, e.g. /api/v1/notifications/analytics/events
ANALYTICS_EVENTS_PATH=
